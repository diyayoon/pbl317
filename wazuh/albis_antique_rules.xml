<!--
  Custom rules Albis Antique E-commerce.
  Copy/merge into /var/ossec/etc/rules/local_rules.xml on Wazuh Manager.
  Rule ID range 100500-100599 is reserved here for this project.
-->
<group name="albis_antique,application_audit,">

  <!-- Parent group: all JSON events generated by Albis Antique. -->
  <rule id="100500" level="0">
    <decoded_as>json</decoded_as>
    <field name="app">^albis-antique$</field>
    <description>Albis Antique application audit event.</description>
    <options>no_full_log</options>
  </rule>

  <!-- Authentication -->
  <rule id="100510" level="3">
    <if_sid>100500</if_sid>
    <field name="event_action">^auth\.login\.failed$</field>
    <description>Albis Antique: failed login attempt from $(source_ip).</description>
    <group>authentication_failed,albis_auth,</group>
  </rule>
  <rule id="100511" level="10" frequency="5" timeframe="300">
    <if_matched_sid>100510</if_matched_sid>
    <same_field>source_ip</same_field>
    <description>Albis Antique: possible brute force - 5 failed logins from the same source IP within 5 minutes.</description>
    <group>authentication_failed,brute_force,albis_auth,</group>
  </rule>
  <rule id="100512" level="8">
    <if_sid>100500</if_sid>
    <field name="event_action">^auth\.login\.rate_limited$</field>
    <description>Albis Antique: login rate limit triggered from $(source_ip).</description>
    <group>authentication_failed,albis_auth,</group>
  </rule>
  <rule id="100513" level="7">
    <if_sid>100500</if_sid>
    <field name="event_action">^auth\.access\.denied$</field>
    <description>Albis Antique: application authorization denied for $(target_id).</description>
    <group>access_control,albis_auth,</group>
  </rule>
  <rule id="100514" level="3">
    <if_sid>100500</if_sid>
    <field name="event_action" type="pcre2">^auth\.(login\.(success|admin_success)|logout|register\.success)$</field>
    <description>Albis Antique: successful authentication activity $(event_action).</description>
    <group>application_audit,authentication_success,</group>
  </rule>

  <rule id="100515" level="3">
    <if_sid>100500</if_sid>
    <field name="event_action" type="pcre2">^customer\.(profile|addresses)\.updated$</field>
    <description>Albis Antique: customer updated account profile or saved addresses.</description>
    <group>application_audit,customer_activity,</group>
  </rule>
  <rule id="100516" level="3">
    <if_sid>100500</if_sid>
    <field name="event_action" type="pcre2">^(order\.(created|cancelled)|review\.created|payment\.(proof_uploaded|transaction\.created|settled|cancelled|expired))$</field>
    <description>Albis Antique: routine order or payment activity $(event_action).</description>
    <group>application_audit,commerce_activity,payment_audit,</group>
  </rule>
  <rule id="100517" level="5">
    <if_sid>100500</if_sid>
    <field name="event_action">^refund\.gateway_failed$</field>
    <description>Albis Antique: refund request failed at the payment gateway.</description>
    <group>payment_audit,payment_failure,</group>
  </rule>
  <rule id="100518" level="3">
    <if_sid>100500</if_sid>
    <field name="event_action" type="pcre2">^auth\.(email_verification\.(sent|success)|password\.changed)$</field>
    <description>Albis Antique: account verification or password change activity $(event_action).</description>
    <group>application_audit,authentication,</group>
  </rule>
  <rule id="100519" level="3">
    <if_sid>100500</if_sid>
    <field name="event_action" type="pcre2">^refund\.(requested|rejected|sent_to_gateway|confirmed)$</field>
    <description>Albis Antique: refund lifecycle activity $(event_action).</description>
    <group>application_audit,payment_audit,refund_activity,</group>
  </rule>
  <rule id="100522" level="5">
    <if_sid>100500</if_sid>
    <field name="event_action" type="pcre2">^auth\.(email_verification\.(delivery_failed|failed)|password\.change_failed)$</field>
    <description>Albis Antique: account verification or password change failed.</description>
    <group>authentication_failed,application_security,</group>
  </rule>

  <!-- Administration audit events: specific destructive actions precede the general activity rule. -->
  <rule id="100521" level="5">
    <if_sid>100500</if_sid>
    <field name="event_action" type="pcre2">^admin\.(product|category)\.deleted$</field>
    <description>Albis Antique: administrator deleted a catalog item.</description>
    <group>application_audit,admin_activity,</group>
  </rule>
  <rule id="100520" level="3">
    <if_sid>100500</if_sid>
    <field name="event_category">^administration$</field>
    <description>Albis Antique: administrator activity $(event_action).</description>
    <group>application_audit,admin_activity,</group>
  </rule>

  <rule id="100523" level="6">
    <if_sid>100500</if_sid>
    <field name="event_action">^file\.upload\.rejected$</field>
    <description>Albis Antique: an uploaded file failed server-side validation.</description>
    <group>application_security,file_integrity,</group>
  </rule>
  <rule id="100524" level="5">
    <if_sid>100500</if_sid>
    <field name="event_action" type="pcre2">^admin\.product\.certificate_(uploaded|removed)$</field>
    <description>Albis Antique: product proof or authenticity certificate was changed by an administrator.</description>
    <group>application_audit,admin_activity,</group>
  </rule>

  <rule id="100525" level="4">
    <if_sid>100500</if_sid>
    <field name="event_action">^auth\.register\.failed$</field>
    <description>Albis Antique: registration attempt rejected by application validation.</description>
    <group>authentication_failed,application_security,albis_auth,</group>
  </rule>

  <rule id="100526" level="8">
    <if_sid>100500</if_sid>
    <field name="event_action">^auth\.register\.rate_limited$</field>
    <description>Albis Antique: registration rate limit triggered from $(source_ip).</description>
    <group>authentication_failed,brute_force,albis_auth,</group>
  </rule>

  <!-- Payment anomalies -->
  <rule id="100530" level="10">
    <if_sid>100500</if_sid>
    <field name="event_action" type="pcre2">^payment\.(amount_mismatch|signature_invalid|invalid_transition|fraud_status_not_accepted|unauthorized_access)$</field>
    <description>Albis Antique: critical payment/business-logic anomaly $(event_action), target $(target_id).</description>
    <group>payment_anomaly,application_security,</group>
  </rule>
  <rule id="100531" level="9">
    <if_sid>100500</if_sid>
    <field name="event_action">^payment\.order_not_found$</field>
    <description>Albis Antique: Midtrans notification references unknown order $(target_id).</description>
    <group>payment_anomaly,application_security,</group>
  </rule>
  <rule id="100532" level="9">
    <if_sid>100500</if_sid>
    <field name="event_action">^payment\.settled_after_cancel$</field>
    <description>Albis Antique: payment settlement received after order cancellation; manual review required.</description>
    <group>payment_anomaly,application_security,</group>
  </rule>
  <rule id="100533" level="4">
    <if_sid>100500</if_sid>
    <field name="event_action">^payment\.notification\.duplicate$</field>
    <description>Albis Antique: duplicate Midtrans notification received; idempotent handling applied.</description>
    <group>payment_audit,application_audit,</group>
  </rule>
  <rule id="100534" level="6">
    <if_sid>100500</if_sid>
    <field name="event_action">^payment\.notification\.invalid_payload$</field>
    <description>Albis Antique: malformed or oversized Midtrans notification was rejected.</description>
    <group>payment_anomaly,application_security,</group>
  </rule>

  <rule id="100536" level="10">
    <if_sid>100500</if_sid>
    <field name="event_action">^payment\.manual_approval\.blocked$</field>
    <description>Albis Antique: manual admin payment approval attempt against a Midtrans order was blocked.</description>
    <group>payment_anomaly,application_security,admin_activity,</group>
  </rule>

  <!-- Certificate delivery -->
  <rule id="100537" level="3">
    <if_sid>100500</if_sid>
    <field name="event_action">^certificate\.email\.sent$</field>
    <description>Albis Antique: product certificates emailed successfully for order $(target_id).</description>
    <group>application_audit,certificate_delivery,</group>
  </rule>
  <rule id="100538" level="7">
    <if_sid>100500</if_sid>
    <field name="event_action">^certificate\.email\.failed$</field>
    <description>Albis Antique: certificate email delivery failed for order $(target_id).</description>
    <group>application_security,certificate_delivery,email_failure,</group>
  </rule>
  <rule id="100539" level="3">
    <if_sid>100500</if_sid>
    <field name="event_action" type="pcre2">^certificate\.email\.(skipped_no_certificate|retry_requested)$</field>
    <description>Albis Antique: certificate email lifecycle event $(event_action).</description>
    <group>application_audit,certificate_delivery,</group>
  </rule>

  <!-- Catch-all application event: routine and newly added event types remain visible in Wazuh alerts. -->
  <rule id="100590" level="3">
    <if_sid>100500</if_sid>
    <description>Albis Antique: application audit event $(event_action).</description>
    <group>application_audit,albis_antique,</group>
  </rule>

</group>
