# Salin menjadi .env untuk pengembangan lokal (python run.py). JANGAN commit .env.
# Di Portainer isi nilai yang sama pada bagian Environment variables stack.
APP_ENV=development
# Acak, minimal 32 karakter:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ISI_SECRET_ACAK_MINIMAL_32_KARAKTER

# Preview cepat di laptop TANPA PostgreSQL (hanya APP_ENV=development):
#   DATABASE_URL=sqlite:///dev.db   lalu jalankan: python -m flask --app run init-dev-db
#
# Database: albis_db. Password dengan karakter khusus harus di-URL-encode (mis. @ -> %40).
DATABASE_URL=postgresql+psycopg://albis_app:PASSWORD_URL_ENCODED@HOST_DATABASE:5432/albis_db

# Hanya untuk migrasi skema (role OWNER database, berbeda dari albis_app). Kosongkan di web.
MIGRATION_DATABASE_URL=

# Hanya dipakai bila memakai docker-compose.local.yml (PostgreSQL dalam Docker).
POSTGRES_USER=albis_app
POSTGRES_PASSWORD=PASSWORD_LOKAL_KUAT
POSTGRES_DB=albis_db
APP_HTTP_PORT=8081

# Production di belakang nginx: 1. Uji lewat http://IP:PORT saja: SESSION_COOKIE_SECURE=0.
TRUSTED_PROXY_COUNT=1
SESSION_COOKIE_SECURE=1

# Aturan bisnis
ORDER_PAYMENT_TTL_JAM=24
MAX_OPEN_ORDERS=5

# Instruksi pembayaran yang tampil ke customer (isi dengan data rekening toko yang sebenarnya).
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT=
PAYMENT_BANK_HOLDER=
PAYMENT_QRIS_NOTE=

# VERIFIKASI EMAIL OTOMATIS (OTP):
# Satu akun/service pengirim dipakai untuk SEMUA customer. Jangan isi email customer di sini.
# Backend otomatis mengambil email penerima dari form registrasi dan mengirim OTP ke sana.
# Gmail: aktifkan Google 2-Step Verification, buat App Password 16 karakter, lalu isi MAIL_PASSWORD
# dengan App Password tersebut (BUKAN password login Gmail). Jangan commit file .env ke Git.
# Jika memakai provider lain, ganti MAIL_SERVER/PORT/SECURITY sesuai dokumentasi provider.
# APP_BASE_URL: URL dasar aplikasi; wajib di produksi agar tautan verifikasi mengarah ke website yang benar.
APP_BASE_URL=http://127.0.0.1:5000
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURITY=starttls
MAIL_USERNAME=alamat-pengirim@gmail.com
MAIL_PASSWORD=ISI_APP_PASSWORD_GMAIL_DI_SINI
MAIL_FROM=alamat-pengirim@gmail.com
EMAIL_VERIFY_TTL_JAM=24
EMAIL_VERIFY_COOLDOWN_DETIK=60
EMAIL_VERIFY_MAX_PER_JAM=5
# Panjang kode OTP email (4-8; disarankan 6) dan batas salah sebelum kode dimatikan
EMAIL_VERIFY_KODE_DIGIT=6
EMAIL_VERIFY_KODE_MAX_SALAH=5

# --- Midtrans (pembayaran online, mode Snap Redirect) ---
# Kosongkan MIDTRANS_SERVER_KEY untuk menonaktifkan metode "Bayar Online".
# Ambil Server Key di dashboard Midtrans mode SANDBOX: Settings > Access Keys. Cek kuncinya dengan: flask --app run uji-midtrans
# MIDTRANS_IS_PRODUCTION=0 memakai server sandbox, 1 memakai server produksi (uang sungguhan). Awalan kunci tidak dipakai untuk membedakan.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=0
# Notification URL (diisi di dashboard Midtrans, hanya bila aplikasi bisa dijangkau internet): APP_BASE_URL + /midtrans/notifikasi

# --- Ongkir & kedaluwarsa pesanan ---
# Ongkir tarif tetap dalam rupiah (0 = tanpa ongkir). SHIPPING_FREE_ABOVE > 0: gratis ongkir bila subtotal mencapai nilai itu.
SHIPPING_COST_FLAT=25000
SHIPPING_FREE_ABOVE=0
# Pesanan yang lewat batas bayar dibatalkan otomatis (stok kembali) paling sering sekali per interval ini (detik; 0 = nonaktif).
ORDER_EXPIRE_INTERVAL_DETIK=60

