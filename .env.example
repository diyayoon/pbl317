# Salin menjadi .env untuk pengembangan lokal (python run.py). JANGAN commit .env.
# Di Portainer isi nilai yang sama pada bagian Environment variables stack.
APP_ENV=development
# Acak, minimal 32 karakter:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ISI_SECRET_ACAK_MINIMAL_32_KARAKTER

# Preview cepat di laptop TANPA PostgreSQL (hanya APP_ENV=development):
#   DATABASE_URL=sqlite:///dev.db   lalu jalankan: python -m flask --app run init-dev-db
#
# Database: albis_db. Password dengan karakter khusus harus di-URL-encode (mis. @ -> %40).
DATABASE_URL=postgresql+psycopg://albis_app:PASSWORD_URL_ENCODED@HOST_DATABASE:5432/albis_db

# Hanya untuk migrasi skema (role OWNER database, berbeda dari albis_app). Kosongkan di web.
MIGRATION_DATABASE_URL=

# Hanya dipakai bila memakai docker-compose.local.yml (PostgreSQL dalam Docker).
POSTGRES_USER=albis_app
POSTGRES_PASSWORD=PASSWORD_LOKAL_KUAT
POSTGRES_DB=albis_db
APP_HTTP_PORT=8081

# Production di belakang nginx: 1. Uji lewat http://IP:PORT saja: SESSION_COOKIE_SECURE=0.
TRUSTED_PROXY_COUNT=1
SESSION_COOKIE_SECURE=1

# Aturan bisnis
ORDER_PAYMENT_TTL_JAM=24
MAX_OPEN_ORDERS=5

# Instruksi pembayaran yang tampil ke customer (isi dengan data rekening toko yang sebenarnya).
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT=
PAYMENT_BANK_HOLDER=
PAYMENT_QRIS_NOTE=

# Verifikasi email (SMTP). Gmail: aktifkan 2-Step Verification lalu buat App Password (BUKAN password akun).
# Tanpa nilai ini email tidak terkirim dan verifikasi tidak bisa diuji end-to-end.
# APP_BASE_URL wajib di produksi: dipakai membuat tautan verifikasi (jangan memakai header Host dari request).
APP_BASE_URL=https://domain-toko-anda.example
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURITY=starttls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
EMAIL_VERIFY_TTL_JAM=24
EMAIL_VERIFY_COOLDOWN_DETIK=60
EMAIL_VERIFY_MAX_PER_JAM=5
# Panjang kode OTP email (4-8; disarankan 6) dan batas salah sebelum kode dimatikan
EMAIL_VERIFY_KODE_DIGIT=6
EMAIL_VERIFY_KODE_MAX_SALAH=5
